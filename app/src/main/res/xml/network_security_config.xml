<!-- Pilotda server HTTP orqali ishlaydi (ichki tarmoq / Tailscale).
     HTTPS ga o'tganda cleartextTrafficPermitted="false" qiling. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
